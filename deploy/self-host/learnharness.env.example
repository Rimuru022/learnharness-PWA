# LearnHarness self-host configuration (read by learnharness.service).
# setup.sh copies this to ~/.config/learnharness/learnharness.env and fills
# LH_ACCESS_TOKEN with a random value. Keep that file private (chmod 600).

# Required on any server other devices can reach: the token each device
# enters once at /access. 16+ characters; rotate it to sign every device out.
LH_ACCESS_TOKEN=

# Where sessions, the knowledge graph and settings live (back this up).
LH_DATA_DIR=/var/lib/learnharness/data
# Provider API keys saved in Settings → Providers are written here (0600).
LH_AUTH_FILE=/var/lib/learnharness/auth.json

# Loopback port; `tailscale serve` publishes it over HTTPS on your tailnet.
PORT=3000

# Optional: a Chrome/Chromium binary for interactive demos and visual
# explanations (headless). Leave unset if Chrome is installed normally.
#CHROME_PATH=/usr/bin/chromium
